---
import Base from '../layouts/Base.astro';
import TeamCard from '../components/ui/TeamCard.astro';
import ProjectCard from '../components/ui/ProjectCard.astro';
import PersonCard from '../components/ui/PersonCard.astro';
import Chip from '../components/ui/Chip.astro';
import FilterBar from '../components/ui/FilterBar.astro';
import Button from '../components/ui/Button.astro';
import Field from '../components/ui/Field.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import StatusBadge from '../components/ui/StatusBadge.astro';
import type { Team, Project, User } from '../lib/types';

const base = { id: '1', owner_id: null, estado: 'active', creado: '2026-11-16', enlace: 'https://example.com', readme: '' } as const;
const teams: Team[] = [
  { ...base, slug: 'apu-space', nombre: 'APU Space UNI', tipo: 'equipo', pais: 'pe', area: 'aeroespacial', modalidad: 'presencial', nivel: 'pregrado', reclutando: 'si', ciclo_anual: 'abre cada agosto', proxima_apertura: null, abierto_a_externos: 'por_confirmar', resumen: 'Construimos satélites pequeños y cohetes de práctica con estudiantes de la UNI.', origen: 'usuario', verificado_en: null },
  { ...base, slug: 'gia', nombre: 'GIA-PUCP', tipo: 'laboratorio', pais: 'pe', area: 'electrónica', modalidad: 'hibrido', nivel: 'todos', reclutando: 'por_confirmar', ciclo_anual: null, proxima_apertura: null, abierto_a_externos: 'por_confirmar', resumen: 'Grupo de investigación en inteligencia artificial aplicada.', origen: 'curado', verificado_en: '2026-11-16' },
  { ...base, slug: 'polysat', nombre: 'PolySat', tipo: 'competencia', pais: 'us', area: 'aeroespacial', modalidad: 'remoto', nivel: 'pregrado', reclutando: 'no', ciclo_anual: 'ciclo anual', proxima_apertura: null, abierto_a_externos: 'no', resumen: 'Resumen largo para probar cómo se parte el texto en una pantalla de 390 píxeles sin romper el diseño.', origen: 'curado', verificado_en: '2026-11-16' },
];
const project: Project = { ...base, slug: 'mapa-aire', nombre: 'Mapa de aire de Lima', team_id: null, resumen: 'Sensores baratos para medir calidad del aire en colegios.', perfiles_buscados: ['Electrónica', 'Datos', 'Diseño'], area: 'ambiental', pais: 'pe' };
const person: User = { id: 'u', proveedor: 'github', id_proveedor: '1', email: null, nombre: 'Lucía Quispe', handle: 'lucia', carrera: 'Ingeniería electrónica', pais: 'pe', nivel: 'pregrado', habilidades: ['Python', 'PCB', 'ROS'], readme: '', enlace: null, estado: 'active', creado: '2026-11-16' };
---
<Base title="Kit de componentes">
  <Button slot="header-extra" variant="secondary" href="/entrar">Entrar</Button>
  <div class="wrap stack">
    <h1>Encuentra con quién construir.</h1>
    <p>Equipos, proyectos y personas de tu universidad y del mundo. Cada uno te lleva a su propia página.</p>
    <FilterBar values={{ q: '', pais: 'pe' }} facets={{ paises: ['pe', 'us', 'xx'], areas: ['aeroespacial', 'electrónica'] }} hidden={{ tab: 'equipos' }} />
    <h2>Equipos</h2>
    <ul class="trail">{teams.map((t) => <li><TeamCard team={t} /></li>)}</ul>
    <h2>Proyectos y personas</h2>
    <ul class="trail"><li><ProjectCard project={project} /></li><li><PersonCard user={person} /></li></ul>
    <h2>Piezas</h2>
    <p><StatusBadge kind="reclutando" /> <StatusBadge kind="cerrado" /> <StatusBadge kind="por_confirmar" /></p>
    <p><Chip label="Aeroespacial" /> <Chip label="Perú" active /> <Chip label="Remoto" href="#" /></p>
    <p><Button>Guardar cambios</Button> <Button variant="secondary" href="https://example.com" external>Ir a su página</Button> <Button variant="ghost">Reportar</Button></p>
    <form class="stack" style="max-width:32rem">
      <Field label="Nombre del equipo" name="nombre" required hint="Como lo conoce tu comunidad." />
      <Field label="Enlace" name="enlace" type="url" value="http://x" error="Usa un enlace que empiece por https://." />
      <Field label="Modalidad" name="mod" options={[{ value: 'presencial', label: 'Presencial' }, { value: 'remoto', label: 'Remoto' }]} />
      <Field label="README" name="readme" multiline />
    </form>
    <EmptyState title="No encontramos equipos con esos filtros" action={{ label: 'Quitar filtros', href: '/explorar' }}>Prueba con otro país o quita el área.</EmptyState>
  </div>
</Base>
